# ==============================================================================
# CONFIGURACIÓN DEL BOT DE RASTREO DE PRECIOS
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------------------------
# Para desarrollo local (SQLite asíncrono por defecto):
DATABASE_URL=sqlite+aiosqlite:///./bot_precios.db

# Para producción con Supabase (PostgreSQL asíncrono):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# TELEGRAM BOT & CANAL
# ------------------------------------------------------------------------------
# Token de tu bot de Telegram obtenido de @BotFather:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID del canal o grupo donde se publicarán las alertas (ej: -1001234567890 o @MiCanalOfertas):
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# PROGRAMADOR Y REGLAS DE DETECCIÓN
# ------------------------------------------------------------------------------
# Frecuencia de escaneo en minutos (por defecto cada 30 min):
CHECK_INTERVAL_MINUTES=30

# Cooldown anti-spam en horas: no repetir alerta del mismo producto en menos de X horas
# (a menos que el precio baje aún más que su mínimo histórico):
ALERT_COOLDOWN_HOURS=6

# Umbral de descuento por defecto (%) para disparar una alerta si el producto no tiene uno propio:
DEFAULT_DISCOUNT_THRESHOLD_PERCENT=10.0

# Número máximo de peticiones concurrentes de scraping para evitar saturación o bloqueos:
MAX_CONCURRENT_SCRAPES=3

# Timeout en segundos para solicitudes HTTP:
REQUEST_TIMEOUT=20

# ------------------------------------------------------------------------------
# ETIQUETAS DE AFILIADOS
# ------------------------------------------------------------------------------
# Amazon Associates Tag / ID de Afiliado (ej: tu-tag-21):
AMAZON_AFFILIATE_TAG=mitagafiliado-21

# Mercado Libre Afiliados / Tracking Parameter:
MERCADOLIBRE_AFFILIATE_TAG=
